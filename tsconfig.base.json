{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@playpass/types/*": ["packages/types/src/*"],
      "@playpass/config/*": ["packages/config/*"],
      "@playpass/ui/*": ["packages/ui/src/*"]
    }
  }
}